# DocuFlow Application Environment Configuration

# Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Production PostgreSQL URL:
# DATABASE_URL=postgresql://docuflow_user:docuflow_password@localhost:5432/docuflow_db
# Local SQLite fallback for development/testing:
DATABASE_URL=sqlite:///./docuflow.db

# Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=20

# Background Worker & Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OCR Settings
TESSERACT_CMD=tesseract
